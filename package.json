{
  "name": "freewater-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FreeWater platform: modular middleware for printing personalized, ad-supported products in real time.",
  "scripts": {
    "demo": "tsx src/demo/run.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "demo:packs": "tsx src/demo/night.ts",
    "start": "tsx src/server/main.ts",
    "key": "tsx src/server/keys.ts",
    "demo:scan": "tsx src/demo/scanDemo.ts",
    "demo:scan-preview": "tsx src/demo/scanPreview.ts",
    "demo:app": "tsx src/demo/appDemo.ts",
    "demo:app-preview": "tsx src/demo/appPreview.ts",
    "demo:ads": "tsx src/demo/adsDemo.ts",
    "demo:ads-preview": "tsx src/demo/adsPreview.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.12",
    "@google/model-viewer": "^3.5.0",
    "ajv": "^8.17.1",
    "fastify": "^4.28.1",
    "jsqr": "^1.4.0",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
